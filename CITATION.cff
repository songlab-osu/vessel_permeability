# GitHub uses this file for the "Cite this repository" button, and Zenodo
# uses it for the software record created from each GitHub release.
# When releasing, keep "version" equal to the git tag (without the "v") and
# set "date-released" to the release date.
cff-version: 1.2.0
title: VesselPermeabilityAnalysis
message: "If you use this software, please cite it using these metadata."
